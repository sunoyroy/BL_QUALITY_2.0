# Copy to .env.local (eve dev loads it automatically) and fill in. Never commit it.

# OpenAI-compatible LLM gateway, same values as leap-genai-api
LLM_GATEWAY=https://openrouter.ai/api/v1
LLM_API_KEY=

# Model the audit agent runs on (must support tool calling)
BL_AUDIT_MODEL=google/gemini-2.5-flash

# Full URL of the existing BL Quality Agent endpoint in leap-genai-api
BL_QUALITY_API_URL=http://localhost:8000/bl_quality
