# Copy to .env.local (eve dev loads it automatically) and fill in. Never commit it.
# Most data sources only answer from inside the LEAP cluster IP range or VPN.
# A tool whose variables are blank returns status NOT_CONFIGURED instead of failing the run.
# Values for the internal services are in leap-go-workers/.../iilServices/utils/config.yaml (prod section).

# --- Model ---------------------------------------------------------------
# OpenAI-compatible LLM gateway, same values as leap-genai-api
LLM_GATEWAY=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model the audit agent runs on (must support tool calling)
BL_AUDIT_MODEL=google/gemini-2.5-flash

# --- Existing BL Quality Agent (run_existing_quality_checks) --------------
BL_QUALITY_API_URL=http://localhost:8000/bl_quality

# --- Databases (read-only users; sessions are also forced read-only) ------
# imbl report replica: ETO_OFR*, DIR_QUERY_FREE, WhatsApp tables, GLCAT_MCAT
PG_IMBUYREC_R_URL=postgres://USER:PASSWORD@HOST:5432/DB
# enquiry replica: PNS_CALL_ALL_RECORDS
PG_ENQ_R_URL=postgres://USER:PASSWORD@HOST:5432/DB
# postgreML: leap_blml_agent_audit_log
PG_LEAP_ML_URL=postgres://USER:PASSWORD@HOST:5432/DB
# LEAP Redis: MCAT_QTY_STATS:*, VANI_MCAT_MANUAL:*
REDIS_URL=redis://HOST:6379/0

# --- Shared access key (config.yaml leadsAk; locked to cluster IPs) -------
LEADS_AK=

# --- get_current_bl / get_attribute_definitions (getisq) ------------------
ISQ_API_URL=http://leads.imutils.com/wservce/buyleads/getisq/
ISQ_TOKEN=

# --- get_buyer_activity (bizfeed) ----------------------------------------
BIZFEED_URL=http://bizfeed.imutils.com
BIZFEED_MOD_ID=GLADMIN

# --- get_product_context --------------------------------------------------
# Ends with displayid_str/; product IDs are appended
PRODUCT_DETAIL_URL=http://users.imutils.com/wservce/products/detail/modid/LEAP/token/TOKEN/displayid_str/
# {id} is replaced with the product display ID; leave blank to skip product specs
PRODUCT_SPEC_URL_TEMPLATE=

# --- get_buyer_profile ----------------------------------------------------
BUYER_PROFILE_URL=http://users.imutils.com/wservce/users/buyerprofile/
# Use the token exactly as the Go service sends it (already URL-encoded)
BUYER_PROFILE_TOKEN=
# RC4 key used to build the K parameter
BUYER_PROFILE_K_SECRET=

# --- get_whatsapp_history (9696 buyer messages) ---------------------------
WAAPI_BFD_URL=http://waapi.imutils.com/api/go/get_extractor_llm_calling

# --- get_vaani_evidence (call extraction, only when extract=true) ---------
CALL_DATA_EXTRACTOR_URL=http://leap-llm.intermesh.net/call_data_extractor

# --- search_mcat_taxonomy --------------------------------------------------
MCAT_SEARCH_URL=http://searchtools.indiamart.com:8983/tools/related_info
# Ends with /id/; the MCAT ID is appended
MCAT_DETAIL_URL=http://users.imutils.com/wservce/im/MasterDetail/modid/LEAP/token/TOKEN/type/MCAT/id/

# --- get_mcat_quantity_stats (price buckets) -------------------------------
MCAT_PRICE_URL=https://merp.intermesh.net/go/api/dwh/v1/mcatunittov
DEVTRON_AK=
# Optional: the Go worker sends a fixed X-Forwarded-For; set it only if the service requires it
MCAT_PRICE_FORWARDED_FOR=
